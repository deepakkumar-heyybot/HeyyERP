{
  "name": "@heyyerp/auth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "auth generate --config src/auth.ts",
    "db:migrate": "auth migrate --config src/auth.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-auth": "1.7.13",
    "dotenv": "^17.2.0",
    "hono": "^4.9.0",
    "kysely": "^0.28.8",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "auth": "1.7.13",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
