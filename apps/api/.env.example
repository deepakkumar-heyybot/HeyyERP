APP_NAME=heyyERP API
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/heyyerp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_LEVEL=INFO
AUTH_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173
REQUIRED_ORG_SLUG=v-rub-suspensions
ORG_TENANT_MAP={"v-rub-suspensions":"00000000-0000-0000-0000-000000000000"}
