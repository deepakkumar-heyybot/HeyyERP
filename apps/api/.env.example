APP_NAME=heyyERP API
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/heyyerp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
LOG_LEVEL=INFO
AUTH_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173
REQUIRED_ORG_SLUG=v-rub-suspensions
ORG_TENANT_MAP={"v-rub-suspensions":"00000000-0000-0000-0000-000000000000"}
MIGRATION_DATABASE_URL=postgresql://owner_role:password@localhost:5432/heyyerp
# Encrypts bank account numbers. 32 random bytes, base64: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Everyone who shares a database must use the same value. Never commit it.
DATA_ENCRYPTION_KEY=
